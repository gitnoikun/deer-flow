# ============================================================================
# DeerFlow 国内部署环境变量模板
# 复制到仓库根目录 .env 后填写。.env 会被 gitignore，不含密钥时也不应提交。
# 构建阶段变量（APT_MIRROR / UV_INDEX_URL / NPM_REGISTRY 等）会传给 docker build，
# 运行时变量（API Key 等）会被 docker-compose 注入容器。
# ============================================================================

# ── 1. 端口 & 绑定 ──────────────────────────────────────────────────────────
# 默认仅绑定本机(127.0.0.1)。要跨机器访问设 BIND_HOST=0.0.0.0（见 README 第4节安全提示）
# BIND_HOST=127.0.0.1
# PORT=2026


# ── 2. 国内镜像源（构建阶段用，按需填）──────────────────────────────────────
# apt/deb 镜像（不带 https:// 前缀，填域名）
# APT_MIRROR=mirrors.aliyun.com
# pip/luv 镜像
# UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# npm 镜像（pnpm 也走这个）
# NPM_REGISTRY=https://registry.npmmirror.com


# ── 3. 模型 API Key（至少填一个，才能跑 agent）───────────────────────────────
# OPENAI_API_KEY=sk-xxxx
# DEEPSEEK_API_KEY=sk-xxxx
# GEMINI_API_KEY=xxxx
# MOONSHOT_API_KEY=sk-xxxx
# OPENVIKING_API_KEY=xxxx

# 用哪种模型，需在 config.yaml 里的 models: 段配置对应 provider + api_key env。
# config.yaml 里 api_key_env 指向的环境变量名，必须是这里定义的 key。
# 例如 config.local.yaml 里 models[0].api_key_env: OPENAI_API_KEY，就填上述 OPENAI_API_KEY。


# ── 4. 搜索 / 网页工具 Key（可选，按需）─────────────────────────────────────
# SERPER_API_KEY=your-serper-api-key
# TAVILY_API_KEY=your-tavily-api-key
# JINA_API_KEY=your-jina-api-key
# INFOQUEST_API_KEY=your-infoquest-api-key


# ── 5. 内部鉴权（deploy.sh 会自动生成并持久化，一般不用手动填）─────────────
# BETTER_AUTH_SECRET=
# DEER_FLOW_INTERNAL_AUTH_TOKEN=


# ── 6. Docker 沙箱 / Provisioner（默认本地沙箱不需要）──────────────────────
# 仅当 config.yaml 用 AioSandboxProvider + provisioner 时才需要：
# PROVISIONER_API_KEY=your-provisioner-api-key


# ── 7. LangSmith 追踪（可选，默认关闭）─────────────────────────────────────
# LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=your-langsmith-project


# ── 8. 构建时镜像相关（一般不用改，除非你想覆盖）──────────────────────────
# UV_IMAGE=ghcr.io/astral-sh/uv:0.11.1
# LARK_CLI_NPM_VERSION=1.0.65


# ── 9. 运行期容器访问 Gateway 的路径（docker-compose 已默认；本地单独跑才改）───
# DEER_FLOW_INTERNAL_GATEWAY_BASE_URL=http://localhost:8001
# DEER_FLOW_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:2026
